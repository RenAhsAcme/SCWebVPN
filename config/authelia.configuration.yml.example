# Authelia 4.39.20 single-node template. Secrets are supplied through Authelia's
# documented *_FILE environment variables and never placed in this file.

server:
  address: tcp://127.0.0.1:9091/
  endpoints:
    authz:
      auth-request:
        implementation: AuthRequest

log:
  level: info
  format: json

totp:
  issuer: example.com

authentication_backend:
  file:
    path: /etc/authelia/users_database.yml

access_control:
  default_policy: deny
  rules:
    - domain: auth.vpn.example.com
      policy: bypass
    - domain:
        - vpn.example.com
        - '*.vpn.example.com'
      policy: two_factor

session:
  cookies:
    - domain: vpn.example.com
      authelia_url: https://auth.vpn.example.com
      default_redirection_url: https://vpn.example.com
      name: webvpn_session
      same_site: lax
      inactivity: 30m
      expiration: 2h
      remember_me: -1

regulation:
  max_retries: 5
  find_time: 2m
  ban_time: 15m

storage:
  local:
    path: /var/lib/authelia/webvpn.sqlite3

notifier:
  filesystem:
    filename: /var/lib/authelia/notifications.txt
